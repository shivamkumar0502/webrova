# Never commit live keys. Copy this file to .env for local development.
NODE_ENV=development
PORT=3000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Set these estimates to match the selected model's current pricing.
LLM_INPUT_USD_PER_MILLION=0.30
LLM_OUTPUT_USD_PER_MILLION=2.50
LLM_MAX_OUTPUT_TOKENS=16384
LLM_MAX_ATTEMPTS=2
E2B_API_KEY=
E2B_TEMPLATE=base
# Dedicated DEV database only; never point a generated app at production data.
SANDBOX_DATABASE_URL=
# Redis must support JSON and Search. Omit only for nonpersistent development.
REDIS_URL=
ACCESS_PASSWORD=
SANDBOX_DIR=./sandboxes
