PORT=3000
NODE_ENV=production
GEMINI_MODEL=gemini-2.5-flash
# Set these as secrets in Render. Never commit actual values.
# Cloud accounts stay disabled until MONGODB_URI is configured.
MONGODB_URI=
MONGODB_DB=webrova
# Owner's Gemini API key. Users never need to provide their own key in Studio.
GEMINI_API_KEY=
# Each provider attempt consumes one daily credit, including failed attempts.
DAILY_USER_BUILDS=3
DAILY_GLOBAL_BUILDS=20
DAILY_IP_BUILDS=6
