{
  "name": "ai-dev-team",
  "version": "2.0.0",
  "description": "AI-Powered Multi-Agent Software Development Team",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node server/free/index.js",
    "server": "node server/free/index.js",
    "dashboard": "cd dashboard && npm run dev",
    "dev": "concurrently \"npm run server\" \"npm run dashboard\"",
    "test:graph": "node tests/test-graph-skeleton.js",
    "test:pm": "node tests/test-pm-agent.js",
    "test:architect": "node tests/test-architect.js",
    "test:validator": "node tests/test-validator.js",
    "test:planner": "node tests/test-planner.js",
    "test:sandbox": "node tests/test-sandbox.js",
    "test:devloop": "node tests/test-devloop.js",
    "test:all:mock": "node tests/test-graph-skeleton.js && node tests/test-validator.js && node tests/test-sandbox.js && node tests/test-devloop.js",
    "cli": "node src/index.js",
    "build": "npm --prefix dashboard ci --include=dev && npm --prefix dashboard run build",
    "test:platform": "node --test tests/test-platform.js",
    "start:advanced": "node server/index.js",
    "test:free": "node --test tests/test-free-cloud.js",
    "test:workspace": "node --test tests/test-workspace.js"
  },
  "dependencies": {
    "@google/genai": "^1.43.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@langchain/langgraph": "^1.2.0",
    "@langchain/langgraph-checkpoint-redis": "^1.0.1",
    "concurrently": "^9.0.1",
    "cors": "^2.8.5",
    "e2b": "^2.58.0",
    "readline": "^1.3.0",
    "ws": "^8.19.0"
  },
  "engines": {
    "node": ">=22"
  }
}
